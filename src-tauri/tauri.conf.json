{
  "$schema": "https://raw.githubusercontent.com/nicktomlin/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "Hark Desk",
  "version": "../package.json",
  "identifier": "com.goxf.harkdesk",
  "build": {
    "beforeDevCommand": "pnpm --filter ./frontend dev --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "node scripts/tauri-before-build.js",
    "beforeBundleCommand": "node scripts/tauri-before-bundle.js",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hark Desk",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vibex-mcp",
      "binaries/vibex-workflow-mcp"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vibex"]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": [
        "https://github.com/GOXF/hark-desk/releases/download/nightly/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4QzYwNDVDMkNFNEEzREUKUldUZW8rUXNYQVRHT09NdHc3eGh0bi93QzR4L2NvZkdzZDE1WW02UDRORnlybnRTL0dRRmt0WWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
